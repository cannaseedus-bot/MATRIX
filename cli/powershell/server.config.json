{
  "$schema": "./server.schema.json",
  "kuhul_class": "api.local.static",
  "server": {
    "port": 8080,
    "root": "./public",
    "api_enabled": true
  },
  "cors": {
    "allow_origin": "*",
    "allow_methods": ["GET", "OPTIONS"],
    "allow_headers": ["Content-Type"]
  },
  "static": {
    "index": "index.html",
    "cache_max_age": 3600
  },
  "api": {
    "endpoints": [
      { "path": "/", "handler": "status" },
      { "path": "/status", "handler": "status" },
      { "path": "/health", "handler": "health" },
      { "path": "/api/agents", "handler": "agents" },
      { "path": "/api/models", "handler": "models" },
      { "path": "/api/ollama/models", "handler": "models" }
    ]
  },
  "kuhul": {
    "domain": "host",
    "scope": "localhost",
    "authority": "read-only",
    "pi_support": 1.0
  }
}
