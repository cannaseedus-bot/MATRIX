{
  "$schema": "xjson://schema/core/v1",
  "@id": "xcfe://spec/cm1/v1",
  "@kind": "specification",
  "@status": "draft-frozen",
  "@version": "1.0.0",
  "@purpose": "Invisible control alphabet for XCFE / DOM / CSS safe execution",

  "principle": "CM-1 defines a non-rendering, non-executing control layer composed exclusively of Unicode C0 control characters (U+0000–U+001F) and U+0020 (SPACE). CM-1 never introduces behavior. It only constrains interpretation.",

  "execution_model": {
    "order": ["cm1_stream", "xcfe_phase_resolution", "parser_renderer_dom"],
    "cannot": ["inject_tokens", "create_nodes", "alter_values", "execute_logic"],
    "can": ["mark_boundaries", "declare_phases", "signal_scope_transitions", "segment_streams", "annotate_interpretation_zones"]
  },

  "control_codes": {
    "phase": {
      "NUL": { "code": "U+0000", "xcfe": "@control.null", "meaning": "Absolute inert region" },
      "SOH": { "code": "U+0001", "xcfe": "@control.header.begin", "meaning": "Metadata/header phase" },
      "STX": { "code": "U+0002", "xcfe": "@control.body.begin", "meaning": "Interpretable content" },
      "ETX": { "code": "U+0003", "xcfe": "@control.body.end", "meaning": "Content closure" },
      "EOT": { "code": "U+0004", "xcfe": "@control.transmission.end", "meaning": "Collapse / flush" }
    },
    "scope": {
      "SO":  { "code": "U+000E", "xcfe": "@control.scope.push", "meaning": "Enter sub-context" },
      "SI":  { "code": "U+000F", "xcfe": "@control.scope.pop", "meaning": "Exit sub-context" },
      "ESC": { "code": "U+001B", "xcfe": "@control.mode.switch", "meaning": "Grammar / parser mode shift" },
      "DLE": { "code": "U+0010", "xcfe": "@control.literal.escape", "meaning": "Bypass interpretation" }
    },
    "segmentation": {
      "FS": { "code": "U+001C", "xcfe": "@control.file.sep", "meaning": "Major boundary" },
      "GS": { "code": "U+001D", "xcfe": "@control.group.sep", "meaning": "Group boundary" },
      "RS": { "code": "U+001E", "xcfe": "@control.record.sep", "meaning": "Record boundary" },
      "US": { "code": "U+001F", "xcfe": "@control.unit.sep", "meaning": "Atomic unit boundary" }
    },
    "transport": {
      "ENQ": { "code": "U+0005", "xcfe": "@control.query", "meaning": "Capability inquiry" },
      "ACK": { "code": "U+0006", "xcfe": "@control.ack", "meaning": "Acceptance" },
      "NAK": { "code": "U+0015", "xcfe": "@control.nak", "meaning": "Rejection" },
      "BEL": { "code": "U+0007", "xcfe": "@control.attention", "meaning": "Wake / notify" }
    }
  },

  "safe_subset": {
    "allowed": [
      "U+0000", "U+0001", "U+0002", "U+0003", "U+0004",
      "U+000E", "U+000F", "U+0010",
      "U+001C", "U+001D", "U+001E", "U+001F", "U+0020"
    ],
    "conditional": {
      "codes": ["U+0009", "U+000A", "U+000D", "U+001B"],
      "rules": [
        "Not allowed inside CSS identifiers",
        "Not allowed inside attribute names",
        "Allowed inside comments, text nodes, JSON strings"
      ]
    },
    "forbidden": {
      "codes": ["U+0008", "U+000B", "U+000C", "U+0018", "U+001A"],
      "reason": "Layout mutation, cursor motion, rendering side-effects, parser instability"
    }
  },

  "invariants": {
    "structural": [
      "Every STX must have a matching ETX",
      "Scope stack (SO/SI) must be balanced",
      "Separators may not nest illegally",
      "ESC cannot appear inside literal-escaped regions",
      "NUL regions are non-observable"
    ],
    "projection": "Removing all CM-1 characters must not change visible output"
  },

  "xcfe_binding": {
    "@control": {
      "null": "\u0000",
      "header.begin": "\u0001",
      "body.begin": "\u0002",
      "body.end": "\u0003",
      "transmission.end": "\u0004",
      "scope.push": "\u000E",
      "scope.pop": "\u000F",
      "literal.escape": "\u0010",
      "file.sep": "\u001C",
      "group.sep": "\u001D",
      "record.sep": "\u001E",
      "unit.sep": "\u001F",
      "space": "\u0020"
    }
  }
}
