{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mx2lm-powershell-server-schema",
  "title": "MX2LM PowerShell Server Configuration",
  "description": "Configuration schema for KUHUL-governed PowerShell static server",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "kuhul_class": {
      "type": "string",
      "description": "KUHUL class identifier",
      "enum": ["api.local.static", "api.local.dynamic", "host.launcher"]
    },
    "server": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8080
        },
        "root": {
          "type": "string",
          "default": "./public"
        },
        "api_enabled": {
          "type": "boolean",
          "default": true
        }
      },
      "required": ["port"]
    },
    "cors": {
      "type": "object",
      "properties": {
        "allow_origin": {
          "type": "string",
          "default": "*"
        },
        "allow_methods": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["GET", "OPTIONS"]
        },
        "allow_headers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "static": {
      "type": "object",
      "properties": {
        "index": {
          "type": "string",
          "default": "index.html"
        },
        "cache_max_age": {
          "type": "integer",
          "minimum": 0,
          "default": 3600
        }
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "endpoints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "handler": { "type": "string" }
            },
            "required": ["path", "handler"]
          }
        }
      }
    },
    "kuhul": {
      "type": "object",
      "description": "KUHUL constraint configuration",
      "properties": {
        "domain": {
          "type": "string",
          "enum": ["host", "network", "cloud"]
        },
        "scope": {
          "type": "string",
          "enum": ["localhost", "lan", "public"]
        },
        "authority": {
          "type": "string",
          "enum": ["read-only", "read-write", "admin"]
        },
        "pi_support": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "π support level for restart policy"
        }
      }
    }
  },
  "required": ["kuhul_class", "server"]
}
