{
  "@context": "asx://schema/control-micronaut-1/v1",
  "@version": "1.0.0",
  "@spec": "CONTROL-MICRONAUT-1 (CM-1)",
  "@status": "Draft-Frozen",
  "@generated": "2026-01-27T00:00:00Z",
  "@law": "ASX = XCFE = XJSON = KUHUL = AST = CM-1",

  "@cm1_identity": {
    "@statement": "CM-1 defines a non-rendering, non-executing control layer composed exclusively of Unicode C0 control characters (U+0000–U+001F) and U+0020 (SPACE).",
    "@execution_model": "CM-1 participates BEFORE syntax. CM-1 cannot inject tokens, create nodes, alter values, or execute logic. CM-1 can only mark boundaries, declare phases, signal scope transitions, segment streams, and annotate interpretation zones.",
    "@projection_invariant": "Removing all CM-1 characters must not change visible output."
  },

  "@canonical_mapping": {
    "@phase_control": {
      "\u0000": {
        "@code": "NUL",
        "@xcfe": "@control.null",
        "@meaning": "Absolute inert region",
        "@kuhul": null,
        "@safe": "ALWAYS"
      },
      "\u0001": {
        "@code": "SOH",
        "@xcfe": "@control.header.begin",
        "@meaning": "Metadata/header phase",
        "@kuhul": "[Pop]",
        "@safe": "ALWAYS"
      },
      "\u0002": {
        "@code": "STX",
        "@xcfe": "@control.body.begin",
        "@meaning": "Interpretable content",
        "@kuhul": "[Wo]",
        "@safe": "ALWAYS"
      },
      "\u0003": {
        "@code": "ETX",
        "@xcfe": "@control.body.end",
        "@meaning": "Content closure",
        "@kuhul": "[Sek]",
        "@safe": "ALWAYS"
      },
      "\u0004": {
        "@code": "EOT",
        "@xcfe": "@control.transmission.end",
        "@meaning": "Collapse / flush",
        "@kuhul": "[Xul]",
        "@safe": "ALWAYS"
      }
    },

    "@scope_context": {
      "\u000E": {
        "@code": "SO",
        "@xcfe": "@control.scope.push",
        "@meaning": "Enter sub-context",
        "@kuhul": "[K'ayab']",
        "@safe": "ALWAYS"
      },
      "\u000F": {
        "@code": "SI",
        "@xcfe": "@control.scope.pop",
        "@meaning": "Exit sub-context",
        "@kuhul": "[Kumk'u]",
        "@safe": "ALWAYS"
      },
      "\u001B": {
        "@code": "ESC",
        "@xcfe": "@control.mode.switch",
        "@meaning": "Grammar / parser mode shift",
        "@kuhul": null,
        "@safe": "CONTEXT_ONLY"
      },
      "\u0010": {
        "@code": "DLE",
        "@xcfe": "@control.literal.escape",
        "@meaning": "Bypass interpretation",
        "@kuhul": null,
        "@safe": "ALWAYS"
      }
    },

    "@structural_segmentation": {
      "\u001C": {
        "@code": "FS",
        "@xcfe": "@control.file.sep",
        "@meaning": "Major boundary",
        "@kuhul": null,
        "@safe": "ALWAYS"
      },
      "\u001D": {
        "@code": "GS",
        "@xcfe": "@control.group.sep",
        "@meaning": "Group boundary",
        "@kuhul": null,
        "@safe": "ALWAYS"
      },
      "\u001E": {
        "@code": "RS",
        "@xcfe": "@control.record.sep",
        "@meaning": "Record boundary",
        "@kuhul": null,
        "@safe": "ALWAYS"
      },
      "\u001F": {
        "@code": "US",
        "@xcfe": "@control.unit.sep",
        "@meaning": "Atomic unit boundary",
        "@kuhul": null,
        "@safe": "ALWAYS"
      }
    },

    "@transport_negotiation": {
      "\u0005": {
        "@code": "ENQ",
        "@xcfe": "@control.query",
        "@meaning": "Capability inquiry",
        "@safe": "CONTEXT_ONLY"
      },
      "\u0006": {
        "@code": "ACK",
        "@xcfe": "@control.ack",
        "@meaning": "Acceptance",
        "@safe": "CONTEXT_ONLY"
      },
      "\u0015": {
        "@code": "NAK",
        "@xcfe": "@control.nak",
        "@meaning": "Rejection",
        "@safe": "CONTEXT_ONLY"
      },
      "\u0007": {
        "@code": "BEL",
        "@xcfe": "@control.attention",
        "@meaning": "Wake / notify",
        "@safe": "CONTEXT_ONLY"
      }
    },

    "@space": {
      "\u0020": {
        "@code": "SPACE",
        "@xcfe": "@control.space",
        "@meaning": "Whitespace / separator",
        "@kuhul": null,
        "@safe": "ALWAYS"
      }
    }
  },

  "@safety_classes": {
    "CM1_SAFE": {
      "@description": "Guaranteed non-rendering & non-breaking in DOM, CSS, JSON",
      "@characters": [
        "\u0000",
        "\u0001",
        "\u0002",
        "\u0003",
        "\u0004",
        "\u000E",
        "\u000F",
        "\u0010",
        "\u001C",
        "\u001D",
        "\u001E",
        "\u001F",
        "\u0020"
      ],
      "@guarantees": [
        "Survive JSON strings",
        "Survive HTML text nodes",
        "Survive CSS parsing",
        "Do not affect layout",
        "Ignored by renderers",
        "Preserve byte order"
      ]
    },

    "CONTEXT_SAFE": {
      "@description": "Allowed only in non-rendering channels (comments, data attrs, text nodes not measured)",
      "@characters": [
        "\u0009",
        "\u000A",
        "\u000D",
        "\u001B"
      ],
      "@rules": [
        "NOT allowed inside CSS identifiers",
        "NOT allowed inside attribute names",
        "ALLOWED inside comments, text nodes, JSON strings"
      ]
    },

    "FORBIDDEN": {
      "@description": "Never allowed in CM-1 due to layout mutation, cursor motion, rendering side-effects, or parser instability",
      "@characters": [
        "\u0008",
        "\u000B",
        "\u000C",
        "\u0018",
        "\u001A"
      ],
      "@violation": "ILLEGAL_STATE"
    }
  },

  "@structural_invariants": {
    "balance_stx_etx": {
      "@rule": "Every STX (U+0002) must have a matching ETX (U+0003)",
      "@validation": "AST_BALANCED_CHECK"
    },
    "scope_stack_balance": {
      "@rule": "Scope stack (SO/SI) must be balanced",
      "@validation": "STACK_DEPTH_ZERO_AT_END"
    },
    "separator_nesting": {
      "@rule": "Separators may not nest illegally",
      "@validation": "SEPARATOR_HIERARCHY_CHECK"
    },
    "escape_literal_safety": {
      "@rule": "ESC cannot appear inside literal-escaped regions",
      "@validation": "ESCAPE_DEPTH_CHECK"
    },
    "null_non_observable": {
      "@rule": "NUL regions are non-observable",
      "@validation": "NUL_ZONE_OPACITY_CHECK"
    }
  },

  "@projection_invariant_test": {
    "@definition": "Removing all CM-1 characters must not change visible output",
    "@test_procedure": [
      "1. Render original stream with CM-1 chars",
      "2. Strip all CM-1 chars (U+0000–U+001F + U+0020 in control positions)",
      "3. Render stripped stream",
      "4. Compare DOM structure, CSS layout, text rendering",
      "5. If ANY difference → INVALID STREAM"
    ],
    "@validity": "PASS if and only if output identical"
  },

  "@kuhul_binding": {
    "@execution_pipeline": [
      "[Pop] → U+0001 (SOH) → @control.header.begin",
      "[Wo] → U+0002 (STX) → @control.body.begin",
      "[Sek] → U+0003 (ETX) → @control.body.end",
      "[Xul] → U+0004 (EOT) → @control.transmission.end",
      "[K'ayab'] → U+000E (SO) → @control.scope.push",
      "[Kumk'u] → U+000F (SI) → @control.scope.pop"
    ],
    "@example": "\u0001[Pop example]\u0002[Wo code]\u0003[Sek execute]\u0004[Xul]\u0003"
  },

  "@scxq2_compatibility": {
    "@cm1_as_glyph_markers": true,
    "@compression_strategy": "CM-1 chars treated as structural anchors, not content",
    "@template_matching": "CM-1 boundaries define AST node edges for template extraction",
    "@entropy_reduction": "CM-1 reduces entropy by making structure explicit"
  },

  "@dom_css_json_safety": {
    "json": {
      "@safe_characters": "ALL CM1_SAFE chars allowed inside JSON strings",
      "@escape_required": false,
      "@example": "{\"data\": \"\\u0001header\\u0002body\\u0003end\\u0004\"}"
    },
    "html": {
      "@safe_in_text_nodes": "ALL CM1_SAFE chars",
      "@safe_in_attributes": "CM1_SAFE only (not CONTEXT_SAFE)",
      "@safe_in_comments": "ALL CM1_SAFE + CONTEXT_SAFE"
    },
    "css": {
      "@safe_in_strings": "ALL CM1_SAFE chars",
      "@safe_in_comments": "ALL CM1_SAFE + CONTEXT_SAFE",
      "@forbidden_in_identifiers": "ALL CM-1 chars",
      "@forbidden_in_selectors": "ALL CM-1 chars"
    }
  },

  "@verification_tools": {
