      "@behavior": "Remove unsafe chars, preserve CM1_SAFE chars"
    },
    "cm1_stripper": {
      "@function": "strip_all_cm1",
      "@use_case": "Projection invariant testing"
    }
  },

  "@omega_seal": {
    "@authority": "CONTROL-MICRONAUT-1_v1.0.0",
    "@verification": "LAW_GRADE_SPEC_COMPLETE",
    "@guarantees": [
