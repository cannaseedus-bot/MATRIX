/* ===========================
 * Environment: server
 * =========================== */

@env (device = "server") {

  /* Backends: prefer CUDA, then ROCm, then MPS, CPU as last resort */

  backend[cuda] {
    priority: 1;
    enabled: true;

    preferred-dtype: "fp16";
    allow-quantization: true;

    flash-attention: true;
    cudagraphs: true;
    tensor-parallel: true;

    max-batch-size: 32;
    max-seq-length: 4096;
  }

  backend[rocm] {
    priority: 2;
    enabled: true;

    preferred-dtype: "fp16";
    allow-quantization: true;

    max-batch-size: 24;
    max-seq-length: 4096;
  }

  backend[mps] {
    priority: 3;
    enabled: true;

    preferred-dtype: "fp16";
    unified-memory: true;

    max-batch-size: 8;
    max-seq-length: 4096;
  }

  backend[webgpu],
  backend[webgl] {
    enabled: false;
  }

  backend[cpu] {
    priority: 4;
    enabled: true;

    threads: "max";
    thread-affinity: "performance";
  }

  /* Inference pipeline: throughput-optimized */

  pipeline[name="qwen2.5-7b-instruct"] {
    max-tokens: 4096;
    temperature: 0.6;
    top-p: 0.9;

    batching-strategy: "dynamic";
    target-latency-ms: 200;
  }

  pipeline[name="qwen2.5-7b-instruct"] step[tokenize] {
    runtime: cpu;
    threads: "auto";
  }

  pipeline[name="qwen2.5-7b-instruct"] step[embed] {
    runtime: gpu;
    backend-preference: "cuda, rocm, mps, cpu";
  }

  pipeline[name="qwen2.5-7b-instruct"] step[blocks] {
    runtime: gpu;
    backend-preference: "cuda, rocm, mps, cpu";
  }

  pipeline[name="qwen2.5-7b-instruct"] step[sample] {
    runtime: cpu;
  }

  pipeline[name="qwen2.5-7b-instruct"] step[decode] {
    runtime: cpu;
  }

  /* Execution graph tuning */

  node[operation="attention"] {
    impl: "flash_attention_v2";
    backend: "cuda";
  }

  node[operation="gelu_matmul"] {
    backend: "cuda";
  }

  node[operation="categorical_sample"] {
    backend: "cpu";
  }

  /* Mesh compute: aggressive server cluster behavior */

  node[type="browser.node"] {
    max-concurrent-tasks: 4;
    preferred-role: "offload-light-compute";
  }

  coordinator {
    strategy: "model-parallel";
    micro-batches: 8;
    gradient-accumulation: 16;
  }
}
